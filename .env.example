APP_NAME="Website Profil Desa Digital"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Makassar

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=desa_mpanau
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Sesi (arsitektur monolit) ---
# Situs publik dan dashboard kini disajikan Laravel dari satu origin, sehingga
# tidak ada lagi SANCTUM_STATEFUL_DOMAINS maupun daftar origin CORS.
#
# SESSION_DOMAIN WAJIB kosong. Diisi 'localhost' (warisan penyiapan Sanctum SPA)
# akan membuat cookie sesi tidak terkirim saat situs dibuka lewat 127.0.0.1,
# dan setiap pengiriman formulir gagal dengan 419 Page Expired.
SESSION_DOMAIN=null

# --- Pelindungan Data Pribadi (UU PDP No. 27/2022) ---
# Kunci HMAC untuk membuat blind index (hash) NIK & No. KK agar tetap
# dapat dicari (exact match) tanpa mendekripsi seluruh baris. Lihat PRD 6.3 & 12.2.
# WAJIB diganti di produksi dan JANGAN pernah di-commit.
PII_HASH_KEY=base64:CHANGE_ME_GENERATE_WITH_php_artisan_pii:key

# --- Rate limiting fitur publik sensitif (PRD 6.6) ---
BANSOS_CHECK_RATE_LIMIT=10
BANSOS_CHECK_RATE_DECAY=1

# --- CAPTCHA formulir publik (Cloudflare Turnstile) ---
# Opsional. Bila dikosongkan, verifikasi CAPTCHA dilewati dan formulir tetap
# terlindungi rate limiting. WAJIB diisi sebelum produksi (lihat DEVIASI C9).
# Dapatkan gratis di: dash.cloudflare.com -> Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
