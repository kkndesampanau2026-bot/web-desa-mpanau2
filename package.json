{
  "name": "web-desa-mpanau",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Website Profil Desa Digital — Desa Mpanau, Kec. Sigi Biromaru, Kab. Sigi",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node cek-mysql.js",
    "dev": "concurrently -n laravel,vite -c blue,green \"npm:dev:laravel\" \"npm:dev:vite\"",
    "dev:paksa": "concurrently -n laravel,vite -c blue,green \"npm:dev:laravel\" \"npm:dev:vite\"",
    "dev:laravel": "php artisan serve --port=8000",
    "dev:vite": "vite",

    "setup": "composer install && php artisan key:generate --ansi && php artisan storage:link && php artisan migrate --seed && npm install",

    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",

    "test": "npm run test:api",
    "test:api": "php artisan test",

    "db:fresh": "php artisan migrate:fresh --seed",

    "audit:all": "npm audit && composer audit",

    "bersih": "php artisan optimize:clear"
  },
  "dependencies": {
    "@inertiajs/react": "^2.0.0",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "ziggy-js": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "jsdom": "^28.1.0",
    "laravel-vite-plugin": "^3.2.0",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
